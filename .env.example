# Copy to .env and fill in. Never commit .env.
#
# tastytrade now uses OAuth2 only. One-time setup:
#   1. Log in at my.tastytrade.com -> Manage -> My Profile -> API -> OAuth Applications
#   2. Create a personal OAuth application (grant read + trade scopes)
#   3. Copy the client secret, then generate a personal refresh token
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
